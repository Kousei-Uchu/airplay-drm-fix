{
  "manifest_version": 3,
  "name": "Netflix & Disney+ AirPlay Fix",
  "version": "2.0",
  "author": "Kousei Uchu",
  "homepage_url": "https://github.com/Kousei-Uchu/netflix-disney-screenshare-fix",
  "description": "Prevents black screen on AirPlay",
  "permissions": [
    "scripting",
    "activeTab",
    "declarativeContent"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.disneyplus.com/*",
    "*://*.dssott.com/*",
    "*://*.disney-plus.net/*",
    "*://*.dssedge.com/*",
    "*://*.search-api-disney.bamgrid.com/*",
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.dssott.com/*",
        "*://*.disney-plus.net/*",
        "*://*.dssedge.com/*",
        "*://*.search-api-disney.bamgrid.com/*",
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}

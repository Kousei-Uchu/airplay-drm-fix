{
  "manifest_version": 3,
  "name": "AirPlay Widevine Fix",
  "version": "3.0.0",
  "author": "Kousei Uchu",
  "homepage_url": "https://github.com/Kousei-Uchu/airplay-drm-fix",
  "description": "Works around AirPlay showing a black screen for Widevine-protected video in non-Apple browsers.",
  "minimum_chrome_version": "102",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.disneyplus.com/*",
    "*://*.dssott.com/*",
    "*://*.disney-plus.net/*",
    "*://*.dssedge.com/*",
    "*://*.search-api-disney.bamgrid.com/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
